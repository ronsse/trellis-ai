# Settings for docs/deployment/docker-compose.team.yml.
#
#   cp docs/deployment/.env.example docs/deployment/.env
#
# Compose reads `.env` from the directory of the compose file. `.env` is
# git-ignored. Never commit a real value, and never paste one into a command
# line or a chat. Two ways to fill the secret in:
#
#   1. Set the value in .env and keep the file readable by you only
#      (`chmod 600 docs/deployment/.env`).
#   2. Put an `op://<vault>/<item>/<field>` reference there instead and let
#      1Password inject the value when you run compose, so no secret is written
#      to disk:
#
#        op run --env-file=docs/deployment/.env -- \
#          docker compose -f docs/deployment/docker-compose.team.yml up -d --build

# Required, and left empty on purpose: compose refuses to start until it is set.
# It goes into a connection URL, so use letters and digits (or percent-encode
# any other character).
TRELLIS_PG_PASSWORD=

# Address the API and MCP ports bind on the host. 127.0.0.1 keeps them local;
# put a TLS reverse proxy in front before binding anything else.
TRELLIS_BIND_ADDRESS=127.0.0.1
TRELLIS_API_PORT=8420
TRELLIS_MCP_PORT=8421

# Host port for Postgres, loopback only (used by pg_dump and `admin backup`).
TRELLIS_PG_PORT=5432

# Optional: stamp the image with the commit it was built from
# (`make docker-build` does this for you).
# TRELLIS_BUILD_VERSION=
